# Copy to .env and never commit .env
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-only-change-me-use-a-long-random-value-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose defaults use 5432/6379. The userspace fallback uses 5433/6380.
DATABASE_URL=postgres://trystsol:trystsol@127.0.0.1:5433/trystsol
REDIS_URL=redis://127.0.0.1:6380/0

# Solana
SOLANA_CLUSTER=devnet
# Public/browser-safe endpoint used by wallet-connected clients.
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CThoKseeGQf6wN4jVADhLm549Nw89rsNL8p684iTK8BB
# Private/paid server-side endpoint (Helius, QuickNode). Credential: never expose.
SERVER_RPC_URL=
# Mainnet reads for token mint facts (public fallback is rate limited)
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Auth
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SIWS_DOMAIN=localhost:3000
SIWS_URI=http://localhost:3000
ACCESS_TOKEN_SECRET=dev-only-change-me-use-a-long-random-value-0123456789

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Indexer -> API shared secret
INDEXER_SHARED_SECRET=dev-indexer-secret

# External integrations (read-only, server-side only)
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Mainnet reads for token mint facts (public fallback is rate limited)
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# Optional OAuth app credentials for a later GitHub OAuth flow
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
